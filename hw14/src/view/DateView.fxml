<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.DateController" 
      spacing="15" 
      alignment="CENTER" 
      prefWidth="450" 
      prefHeight="400" 
      style="-fx-padding: 25;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Date Format:" />
        <ComboBox fx:id="formatComboBox" prefWidth="150" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Select Base Date:" />
        <DatePicker fx:id="datePicker" />
    </HBox>
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Formatted Date:" />
        <Label fx:id="displayDateLabel" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    </HBox>

    <Separator />

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Value (x):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="inputNumberField" promptText="Enter an integer" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Direction:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="directionComboBox" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Unit:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="unitComboBox" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <Button fx:id="applyButton" text="Apply" onAction="#handleApply" prefWidth="100" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
    
    <Label fx:id="errorLabel" textFill="#e74c3c" />
    <Label fx:id="resultLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" textFill="#27ae60" />

</VBox>